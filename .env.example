# Clinara HealthOS — local environment example. Copy to .env (never commit real secrets).

# Django
DJANGO_SETTINGS_MODULE=clinara.settings.local
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). The app connects as a non-superuser so Row-Level Security is enforced.
POSTGRES_DB=clinara
POSTGRES_USER=clinara_app
POSTGRES_PASSWORD=clinara_app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=clinara-api
SENTRY_DSN=

# LLM (Phase 1+). No PHI is sent without a BAA; provider is allowlisted and version-pinned.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
